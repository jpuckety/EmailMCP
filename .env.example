# Copy to .env.dev and/or .env.prod (git-ignored). Values usually differ per env.
# Used by: ./run.sh push-secrets-dev   and   ./run.sh push-secrets-prod
# Those commands use AWS profiles mcp-dev / mcp-prod (or DEV_PROFILE / PROD_PROFILE).
#
# Laptop HTTP mode still uses emailmcp/.env (see emailmcp/.env.example).
# Pipeline / ECS do not read these files — they consume SSM SecureString
# parameters /email-mcp/google-client-id and /email-mcp/google-client-secret.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
