# EmailMCP Environment Configuration
# Copy to .env and fill values. Never commit real secrets.
# Pipeline / ECS do not read this file; they use task environment and SSM.

# Server
EMAILMCP_LISTEN_ADDR=:8080

# IMAP pool tuning
EMAILMCP_IMAP_MAX_CONNS=4
EMAILMCP_IMAP_IDLE_TIMEOUT=5m

# SMTP
EMAILMCP_SMTP_TIMEOUT=30s

# Attachments and message size
# Per-attachment decoded size (default 10 MiB)
EMAILMCP_ATTACHMENT_MAX_BYTES=10485760
# Encoded RFC822 message size (default 25 MiB). WorkMail's hard MIME cap is 40 MiB.
EMAILMCP_MESSAGE_MAX_BYTES=26214400
EMAILMCP_ATTACHMENT_URL_TIMEOUT=30s
# Optional comma-separated HTTPS hosts for url attachments (empty = any public HTTPS host)
# EMAILMCP_ATTACHMENT_ALLOWED_HOSTS=s3.amazonaws.com,*.s3.us-east-1.amazonaws.com
# Local path attachments are disabled unless this allowlist is set
# EMAILMCP_ATTACHMENT_PATH_ALLOWLIST=/var/lib/emailmcp/files
# get_attachment returns base64 when at or under this size (default 1 MiB)
EMAILMCP_ATTACHMENT_INLINE_MAX=1048576
# Optional S3 bucket for presigned download URLs when an attachment exceeds the inline cap
# EMAILMCP_ATTACHMENT_S3_BUCKET=
# EMAILMCP_ATTACHMENT_S3_PREFIX=emailmcp-attachments/
# EMAILMCP_ATTACHMENT_PRESIGN_TTL=15m
# After SMTP send, APPEND a copy to Sent: auto (default), true, or false.
# auto skips Gmail (already saves) and APPENDs for WorkMail and other IMAP providers.
EMAILMCP_SAVE_TO_SENT=auto

# Logging
EMAILMCP_LOG_LEVEL=info

# Required: Google OAuth. Per-user email account configuration (including
# IMAP/SMTP credentials) is stored in DynamoDB by this server.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Required for HTTP mode: used by the MCP OAuth authorization-code proxy to Google.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public origin of this server (OAuth issuer + redirect base). Must match the
# authorized redirect URI in Google Cloud Console:
#   {PUBLIC_BASE_URL}/oauth/callback
PUBLIC_BASE_URL=https://email.mcp.ecg.co

APPLICATION_ID=email-mcp

# Optional: HTTPS OAuth redirect_uri allowlist. Comma-separated hostnames,
# wildcards, or https URIs.
#   blank / unset  → allowlist NOT enforced (any HTTPS redirect host accepted)
#   non-empty      → HTTPS redirects must match an entry
# Loopback HTTP (localhost/127.0.0.1) and custom schemes (cursor://) are always allowed.
OAUTH_REDIRECT_ALLOWLIST=

# Optional: DynamoDB tables. On ECS these are injected as EMAILMCP_SESSION_TABLE
# and EMAILMCP_USER_CONFIG_TABLE. Locally, leave unset for in-memory stores, or
# set AWS_REGION so names can be read from SSM:
#   /emailmcp/session-table/name
#   /emailmcp/user-config-table/name
#   /emailmcp/notify-state-table/name
# EMAILMCP_SESSION_TABLE=
# EMAILMCP_USER_CONFIG_TABLE=
# EMAILMCP_NOTIFY_STATE_TABLE=

# Notify transport (`./emailmcp -transport notify`): IMAP IDLE watcher + /health.
# Does not require GOOGLE_CLIENT_ID. On ECS, EMAILMCP_NOTIFY_STATE_TABLE is required.
# EMAILMCP_USER_CONFIG_TABLE is ALWAYS required (shared with the HTTP server/portal).
# EMAILMCP_TRANSPORT=notify
# EMAILMCP_NOTIFY_OWNER=          # unique per task; leave unset to auto-generate
# EMAILMCP_NOTIFY_RECONCILE=30s
# EMAILMCP_NOTIFY_WEBHOOK_TIMEOUT=10s
# EMAILMCP_NOTIFY_MAX_FOLDERS=8

# AWS_REGION=us-east-1
